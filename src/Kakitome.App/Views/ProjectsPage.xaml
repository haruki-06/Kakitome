<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="Kakitome.App.Views.ProjectsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Kakitome.Presentation.ViewModels">

  <Grid Padding="32,24" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock x:Uid="Projects_Header" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
      <TextBox x:Uid="Projects_NewName" Width="320" AutomationProperties.AutomationId="NewProjectName" KeyDown="OnNameKeyDown"
               Text="{x:Bind ViewModel.NewProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <Button x:Uid="Projects_Create" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom"
              AutomationProperties.AutomationId="CreateProject" Command="{x:Bind ViewModel.CreateCommand}" />
    </StackPanel>
    <InfoBar Grid.Row="2" IsOpen="{x:Bind ViewModel.Message, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
             Message="{x:Bind ViewModel.Message, Mode=OneWay}" Severity="{x:Bind SeverityOf(ViewModel.MessageIsError), Mode=OneWay}"
             IsClosable="True" AutomationProperties.AutomationId="ProjectsMessage" />
    <GridView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Projects}" IsItemClickEnabled="True" SelectionMode="None"
              ItemClick="OnProjectClicked" AutomationProperties.AutomationId="ProjectList">
      <GridView.ItemTemplate>
        <DataTemplate x:DataType="vm:ProjectItemViewModel">
          <StackPanel Width="240" Padding="12" Spacing="4" AutomationProperties.Name="{x:Bind AccessibleName}">
            <SymbolIcon Symbol="Folder" HorizontalAlignment="Left" />
            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind LastText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </DataTemplate>
      </GridView.ItemTemplate>
    </GridView>
  </Grid>
</Page>
