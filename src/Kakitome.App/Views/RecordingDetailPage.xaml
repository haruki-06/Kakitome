<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="Kakitome.App.Views.RecordingDetailPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Kakitome.Presentation.ViewModels"
  xmlns:views="using:Kakitome.App.Views">

  <Grid Padding="32,16,32,24" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}"
                   TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent">
        <AppBarButton x:Uid="Detail_ReTranscribe" Icon="Refresh" Command="{x:Bind ViewModel.ReTranscribeCommand}" />
        <AppBarButton x:Uid="Detail_RegenerateSummary" Icon="Edit" Command="{x:Bind ViewModel.RegenerateSummaryCommand}" />
        <AppBarButton x:Uid="Detail_OpenFolder" Icon="Folder" Command="{x:Bind ViewModel.OpenFolderCommand}" />
      </CommandBar>
    </Grid>

    <StackPanel Grid.Row="1" Spacing="8">
      <InfoBar IsOpen="{x:Bind ViewModel.Message, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
               Message="{x:Bind ViewModel.Message, Mode=OneWay}" IsClosable="True" Severity="{x:Bind SeverityOf(ViewModel.IsMessageError), Mode=OneWay}" />
      <InfoBar x:Uid="Detail_GlossaryTip" AutomationProperties.AutomationId="GlossaryTip" Severity="Informational" IsClosable="True"
               IsOpen="{x:Bind ViewModel.ShowGlossaryTip, Mode=TwoWay}" Message="{x:Bind ViewModel.GlossaryTipText, Mode=OneWay}">
        <InfoBar.Content>
          <StackPanel Spacing="4" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Uid="Detail_GlossaryCopy" AutomationProperties.AutomationId="GlossaryCopy" Command="{x:Bind ViewModel.CopyGlossaryRequestCommand}" />
              <Button x:Uid="Detail_GlossaryShowFile" Command="{x:Bind ViewModel.ShowTranscriptFileCommand}" />
              <Button x:Uid="Detail_GlossaryImport" AutomationProperties.AutomationId="GlossaryImport" Command="{x:Bind ViewModel.ImportGlossaryCommand}" />
            </StackPanel>
            <HyperlinkButton x:Uid="Detail_GlossaryHide" Padding="0,4" Command="{x:Bind ViewModel.HideGlossaryTipsCommand}" />
          </StackPanel>
        </InfoBar.Content>
      </InfoBar>
    </StackPanel>

    <Grid Grid.Row="2">
      <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="True" Height="96"
                          AutomationProperties.AutomationId="Player"
                          Visibility="{x:Bind HasAudio(ViewModel.AudioPath), Mode=OneWay}">
        <MediaPlayerElement.TransportControls>
          <MediaTransportControls IsCompact="True" IsZoomButtonVisible="False" />
        </MediaPlayerElement.TransportControls>
      </MediaPlayerElement>
      <!-- Current position / length, e.g. "00:12 / 32:12", just below the seek bar. -->
      <TextBlock x:Name="PositionText" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"
                 FontFamily="Consolas" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 Text="00:00 / 00:00" AutomationProperties.AutomationId="PlaybackPosition" AutomationProperties.LiveSetting="Off"
                 Visibility="{x:Bind HasAudio(ViewModel.AudioPath), Mode=OneWay}" />
      <TextBlock Text="{x:Bind ViewModel.NoAudioText, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind NoAudio(ViewModel.AudioPath), Mode=OneWay}" />
    </Grid>

    <!-- Transcript or summary, one at a time (ADR-032); the choice is remembered. -->
    <SelectorBar x:Name="ViewTabs" Grid.Row="3" SelectionChanged="OnViewTabChanged" AutomationProperties.AutomationId="DetailTabs">
      <SelectorBarItem x:Name="TranscriptTab" x:Uid="Detail_TabTranscript" Tag="transcript" IsSelected="True" AutomationProperties.AutomationId="DetailTabTranscript" />
      <SelectorBarItem x:Name="SummaryTab" x:Uid="Detail_TabSummary" Tag="summary" AutomationProperties.AutomationId="DetailTabSummary" />
    </SelectorBar>

    <!-- Transcript: flowing paragraphs like transcript.md; the segment being heard is highlighted. -->
    <Grid x:Name="TranscriptPane" Grid.Row="4" RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Spacing="4" MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Text="{x:Bind ViewModel.TranscriptInfo, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock x:Uid="Detail_EditHint" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ViewModel.HasTranscript, Mode=OneWay}" />
        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,4,0,0"
                  Visibility="{x:Bind HasItems(ViewModel.Suggestions.Count), Mode=OneWay}" AutomationProperties.AutomationId="DetailSuggestions">
          <Expander.Header>
            <TextBlock x:Uid="Detail_Suggestions" />
          </Expander.Header>
          <StackPanel>
            <ItemsControl ItemsSource="{x:Bind ViewModel.Suggestions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SuggestionViewModel">
                  <Grid ColumnSpacing="8" Margin="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" x:Uid="Detail_Accept" Click="OnAcceptSuggestion" Tag="{x:Bind}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>
      </StackPanel>
      <TextBlock Grid.Row="1" x:Uid="Detail_NoTranscript" TextWrapping="Wrap" Visibility="{x:Bind VisibleWhenFalse(ViewModel.HasTranscript), Mode=OneWay}" />
      <ScrollViewer x:Name="TranscriptScroller" Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                    Visibility="{x:Bind ViewModel.HasTranscript, Mode=OneWay}">
        <RichTextBlock x:Name="TranscriptText" MaxWidth="900" HorizontalAlignment="Left" Padding="0,8,16,24"
                       FontSize="15" LineHeight="28" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="TranscriptText" KeyDown="OnTranscriptKeyDown" />
      </ScrollViewer>
    </Grid>

    <!-- Summary -->
    <ScrollViewer x:Name="SummaryPane" Grid.Row="4" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="900" HorizontalAlignment="Left" Padding="0,8,16,24">
        <TextBlock x:Uid="Detail_NoSummary" Visibility="{x:Bind VisibleWhenFalse(ViewModel.HasSummary), Mode=OneWay}" />
        <!-- Same reading style as the transcript; items that cite the recording play from there when clicked. -->
        <RichTextBlock x:Name="SummaryText" FontSize="15" LineHeight="28" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="SummaryText" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
