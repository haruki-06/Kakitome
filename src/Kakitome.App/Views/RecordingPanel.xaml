<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="Kakitome.App.Views.RecordingPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Kakitome.App.ViewModels"
  xmlns:pvm="using:Kakitome.Presentation.ViewModels"
  xmlns:views="using:Kakitome.App.Views">

  <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Stretch">
    <TextBlock x:Uid="Recording_Header" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />

    <InfoBar
      IsOpen="{x:Bind ViewModel.Message, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
      Message="{x:Bind ViewModel.Message, Mode=OneWay}"
      Severity="{x:Bind SeverityOf(ViewModel.IsMessageError), Mode=OneWay}"
      IsClosable="True"
      Closed="OnMessageClosed" />

    <StackPanel Spacing="12" IsHitTestVisible="{x:Bind ViewModel.IsIdle, Mode=OneWay}" Opacity="{x:Bind OpacityOf(ViewModel.IsIdle), Mode=OneWay}">
      <ComboBox
        x:Uid="Recording_Microphone"
        HorizontalAlignment="Stretch"
        ItemsSource="{x:Bind ViewModel.Microphones}"
        SelectedItem="{x:Bind ViewModel.SelectedMicrophone, Mode=TwoWay}" />

      <ToggleSwitch x:Uid="Recording_SystemAudio" IsOn="{x:Bind ViewModel.IncludeSystemAudio, Mode=TwoWay}" />

      <ComboBox
        x:Uid="Recording_AudioSource"
        HorizontalAlignment="Stretch"
        AutomationProperties.AutomationId="SystemAudioSource"
        Visibility="{x:Bind ShowAppChoice(ViewModel.IncludeSystemAudio), Mode=OneWay}"
        ItemsSource="{x:Bind ViewModel.SystemAudioSources}"
        SelectedItem="{x:Bind ViewModel.SelectedSystemAudioSource, Mode=TwoWay}"
        DropDownOpened="OnAudioSourcesOpened" />

      <ComboBox
        x:Uid="Recording_OutputDevice"
        HorizontalAlignment="Stretch"
        Visibility="{x:Bind ShowOutputDevice(ViewModel.IncludeSystemAudio, ViewModel.IsAllSystemAudio), Mode=OneWay}"
        ItemsSource="{x:Bind ViewModel.OutputDevices}"
        SelectedItem="{x:Bind ViewModel.SelectedOutputDevice, Mode=TwoWay}" />
    </StackPanel>

    <!-- The project stays changeable while recording; the recording moves there when it is stopped. -->
    <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ComboBox x:Uid="Recording_Project" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="RecordingProject"
                ItemsSource="{x:Bind ViewModel.Projects}" SelectedItem="{x:Bind ViewModel.Project, Mode=TwoWay}" />
      <Button Grid.Column="1" x:Uid="Recording_NewProject" VerticalAlignment="Bottom" AutomationProperties.AutomationId="RecordingNewProject"
              Click="OnNewProjectClicked" />
    </Grid>

    <TextBox x:Uid="Recording_Title" Text="{x:Bind ViewModel.Title, Mode=TwoWay}"
             IsHitTestVisible="{x:Bind ViewModel.IsIdle, Mode=OneWay}" Opacity="{x:Bind OpacityOf(ViewModel.IsIdle), Mode=OneWay}" />

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button
        x:Uid="Recording_Start"
        AutomationProperties.AutomationId="StartRecordingButton"
        Style="{StaticResource AccentButtonStyle}"
        Command="{x:Bind ViewModel.StartCommand}"
        Visibility="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
      <Button
        AutomationProperties.AutomationId="PauseResumeButton"
        Content="{x:Bind ViewModel.PauseResumeText, Mode=OneWay}"
        AutomationProperties.Name="{x:Bind ViewModel.PauseResumeText, Mode=OneWay}"
        Command="{x:Bind ViewModel.PauseResumeCommand}"
        Visibility="{x:Bind ViewModel.IsActive, Mode=OneWay}" />
      <Button
        x:Uid="Recording_Stop"
        AutomationProperties.AutomationId="StopRecordingButton"
        Style="{StaticResource AccentButtonStyle}"
        Command="{x:Bind ViewModel.StopCommand}"
        Visibility="{x:Bind ViewModel.IsActive, Mode=OneWay}" />
      <Button
        x:Uid="Recording_Cancel"
        AutomationProperties.AutomationId="DiscardRecordingButton"
        Click="OnCancelClicked"
        IsEnabled="{x:Bind ViewModel.IsActive, Mode=OneWay}"
        Visibility="{x:Bind ViewModel.IsActive, Mode=OneWay}" />
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                 AutomationProperties.AutomationId="RecordingStatusText"
                 AutomationProperties.LiveSetting="Polite" />
      <TextBlock Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}" Style="{StaticResource TitleLargeTextBlockStyle}"
                 FontFamily="Consolas" x:Uid="Recording_Elapsed" AutomationProperties.AutomationId="ElapsedText" />
    </StackPanel>

    <ItemsControl ItemsSource="{x:Bind ViewModel.Streams}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:StreamViewModel">
          <StackPanel Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
            <ProgressBar Value="{x:Bind Level, Mode=OneWay}" Maximum="100"
                         AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" />
            <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Live transcript: a preview while recording; the final transcript is produced afterwards. -->
    <StackPanel Spacing="6" Visibility="{x:Bind views:Bind.HasText(Live.StatusText), Mode=OneWay}" AutomationProperties.AutomationId="LiveTranscript">
      <TextBlock x:Uid="Live_Header" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
      <TextBlock Text="{x:Bind Live.StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="LiveStatus" />
      <ListView x:Name="LiveList" ItemsSource="{x:Bind Live.Lines}" SelectionMode="None" MaxHeight="320"
                Visibility="{x:Bind Live.IsActive, Mode=OneWay}" AutomationProperties.AutomationId="LiveLines">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="pvm:LiveLineViewModel">
            <Grid ColumnSpacing="10" Padding="0,4" Opacity="{x:Bind Opacity, Mode=OneWay}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind TimeText}" FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
              <TextBlock Grid.Column="1" Text="{x:Bind SourceText}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </StackPanel>
  </StackPanel>
</UserControl>
