<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="Kakitome.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Root" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
    <NavigationView
      x:Name="Nav"
      IsBackButtonVisible="Auto"
      IsBackEnabled="{x:Bind ContentFrame.CanGoBack, Mode=OneWay}"
      BackRequested="OnBackRequested"
      SelectionChanged="OnSelectionChanged"
      IsSettingsVisible="True"
      PaneDisplayMode="Auto">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Uid="Nav_Home" Tag="Home" AutomationProperties.AutomationId="NavHome">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Uid="Nav_Library" Tag="Library" AutomationProperties.AutomationId="NavLibrary">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Uid="Nav_Projects" Tag="Projects" AutomationProperties.AutomationId="NavProjects">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Folder" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Uid="Nav_Queue" Tag="Queue" AutomationProperties.AutomationId="NavQueue">
          <NavigationViewItem.Icon><SymbolIcon Symbol="List" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Uid="Nav_Search" Tag="Search" AutomationProperties.AutomationId="NavSearch">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Find" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <Frame x:Name="ContentFrame" Navigated="OnNavigated" />
    </NavigationView>
  </Grid>
</Window>
