<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows adapters: audio capture, power, OS integration, model runtimes. -->
  <PropertyGroup>
    <TargetFramework>$(KakitomeWindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>$(KakitomeWindowsMinVersion)</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>$(KakitomeWindowsMinVersion)</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="System.Diagnostics.EventLog" />
    <PackageReference Include="Whisper.net" />
    <PackageReference Include="LLamaSharp" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan" />
    <PackageReference Include="Whisper.net.Runtime" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kakitome.Storage\Kakitome.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kakitome.Bench" />
    <InternalsVisibleTo Include="Kakitome.Tests" />
  </ItemGroup>
</Project>
